{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=analytics_db.sqlite",
    "Elasticsearch": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Consumer": {
      "MaxRetryAttempts": 5,
      "InitialRetryDelayMs": 500,
      "MaxRetryDelayMs": 30000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Vitrin.Analytics": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "Vitrin",
    "Audience": "Vitrin"
  },
  "OpenTelemetry": {
    "ServiceName": "Vitrin.Analytics",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
