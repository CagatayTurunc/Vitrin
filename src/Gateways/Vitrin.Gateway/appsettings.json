        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-login",
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth-registration-rate-limited-route": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "auth-registration",
