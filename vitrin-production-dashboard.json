            "intervalFactor": 1,
            "legendFormat": "{{service}} P95",
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus"
            },
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{environment=\"$environment\", service=~\"$service\"}[5m])) by (le, service))",
            "format": "time_series",
            "intervalFactor": 1,
            "legendFormat": "{{service}} P99",
            "refId": "B"
          }
        ],
        "title": "⚡ Response Time (P95/P99)",
        "type": "timeseries"
