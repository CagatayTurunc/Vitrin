{
  "dashboard": {
    "id": null,
    "uid": "vitrin-working",
    "title": "Vitrin - Working Dashboard",
    "description": "Working Grafana dashboard for Vitrin microservices",
    "tags": ["vitrin", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Service Uptime",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=~\"vitrin.*\"}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "HTTP Request Rate",
        "type": "graph",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(microsoft_aspnetcore_hosting_total_requests[5m])",
            "refId": "A",
            "legendFormat": "{{job}} - {{instance}}",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      },
      {
        "id": 3,
        "title": "Active Connections",
        "type": "graph",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 0
        },
        "targets": [
          {
            "expr": "microsoft_aspnetcore_hosting_current_requests",
            "refId": "A",
            "legendFormat": "{{job}} - Current Requests",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ]
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "refresh": "10s"
  }
}