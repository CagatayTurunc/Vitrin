# ============================================================
# Vitrin - Docker Environment Variables
# ============================================================
# Bu dosyayı kopyalayarak .env oluşturun:
#   cp .env.example .env
# Ardından kendi değerlerinizle doldurun.
# UYARI: .env dosyasını asla git'e commit etmeyin!
# ============================================================

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# Boş bırakılırsa Redis şifresiz çalışır (Docker iç ağıyla izole).
# Production'da güçlü bir şifre tanımlayın.
REDIS_PASSWORD=

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vitrin_auth

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_VERY_LONG_SECRET_KEY_AT_LEAST_32_CHARS

# ------------------------------------------------------------
# NextAuth
# ------------------------------------------------------------
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_AT_LEAST_32_CHARS
# Prod'da domain kullan: https://vitrin.it.com
# Local dev'de: http://localhost:3002
NEXTAUTH_URL=http://localhost:3002

# ------------------------------------------------------------
# OAuth (opsiyonel)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI (opsiyonel; AI servisi bu değer olmadan sınırlı çalışır)
GEMINI_API_KEY=
AI_DAILY_REQUEST_LIMIT=10

# ------------------------------------------------------------
# Cloudinary (ürün görselleri için)
# ------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ------------------------------------------------------------
# Resend (hesap ve maker e-postaları)
# ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Vitrin <onboarding@resend.dev>
EMAIL_TOKEN_SECRET=CHANGE_ME_EMAIL_TOKEN_SECRET_AT_LEAST_32_CHARS
EMAIL_APP_BASE_URL=http://localhost:3001

# ------------------------------------------------------------
# Next.js
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Yerel admin yardımcı scriptleri (opsiyonel)
VITRIN_ADMIN_EMAIL=
VITRIN_ADMIN_PASSWORD=

# ------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------
# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Elasticsearch (Log Storage)
# Boş bırakılırsa güvenliksiz çalışır — production'da mutlaka şifre set edin.
# İlk kurulumda boş bırak, container ayağa kalktıktan sonra şifre belirle:
#   docker exec vitrin-elasticsearch bin/elasticsearch-reset-password -u elastic -i
ELASTICSEARCH_PASSWORD=CHANGE_ME_ELASTICSEARCH_PASSWORD
ELASTICSEARCH_URL=http://elasticsearch:9200

# Jaeger (Distributed Tracing)
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# OpenTelemetry OTLP Endpoint (Production)
OPENTELEMETRY_OTLP_ENDPOINT=

# Alert Manager (opsiyonel)
ALERTMANAGER_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Log Level (Debug, Information, Warning, Error)
LOG_LEVEL=Information
