{
  "dashboard": {
    "id": null,
    "uid": "vitrin-prod-main-v2",
    "title": "🚀 Vitrin Production - Golden Signals & System Health",
    "description": "Professional production monitoring dashboard following RED (Rate, Errors, Duration) and USE (Utilization, Saturation, Errors) methodologies for microservices architecture",
    "tags": ["vitrin", "production", "red", "use", "golden-signals", "sre"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "schemaVersion": 39,
    "version": 2,
    "links": [
      {
        "asDropdown": false,
        "icon": "external link",
        "includeVars": false,
        "keepTime": false,
        "tags": [],
        "title": "Prometheus",
        "type": "link",
        "url": "http://localhost:9091"
      }
    ],
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "definition": "label_values(up, job)",
          "description": "Services to monitor",
          "error": null,
          "hide": 0,
          "includeAll": true,
          "label": "Service",
          "multi": true,
          "name": "service",
          "options": [],
          "query": "label_values(up, job)",
          "refresh": 1,
          "regex": "vitrin.*",
          "skipUrlSync": false,
          "sort": 1,
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    "panels": [
      {
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 100,
        "title": "🔥 GOLDEN SIGNALS - RED METHODOLOGY",
        "type": "row",
        "collapsed": false
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Overall system health status - shows if services are UP or DOWN",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [
              {
                "options": {
                  "0": {
                    "color": "red",
                    "index": 1,
                    "text": "DOWN"
                  },
                  "1": {
                    "color": "green",
                    "index": 0,
                    "text": "HEALTHY"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "none",
            "noValue": "N/A"
          }
        },
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 1
        },
        "id": 1,
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "min(up{job=~\"vitrin.*\"})",
            "legendFormat": "System Status",
            "refId": "A"
          }
        ],
        "title": "🚦 Overall System Health",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Current request rate (requests per second) across all services",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 100
                },
                {
                  "color": "red",
                  "value": 500
                }
              ]
            },
            "unit": "reqps",
            "decimals": 1
          }
        },
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 1
        },
        "id": 2,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "sum(rate(promhttp_metric_handler_requests_total{job=~\"vitrin.*\"}[5m]))",
            "legendFormat": "Total RPS",
            "refId": "A"
          }
        ],
        "title": "📊 Request Rate (RPS)",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Current error rate percentage (4xx + 5xx responses)",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            },
            "unit": "percent",
            "decimals": 2
          }
        },
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 1
        },
        "id": 3,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{environment=\"$environment\", service=~\"$service\", status=~\"4..|5..\"}[5m])) / sum(rate(http_requests_total{environment=\"$environment\", service=~\"$service\"}[5m]))) * 100",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "title": "❌ Error Rate (%)",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "HTTP request rate over time by service",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never"
            },
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 7
        },
        "id": 4,
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{environment=\"$environment\", service=~\"$service\"}[5m])) by (service)",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "title": "📈 Request Rate by Service",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "HTTP response times P95 and P99 percentiles",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "never",
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.2
                },
                {
                  "color": "red",
                  "value": 0.5
                }
              ]
            },
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 7
        },
        "id": 5,
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{environment=\"$environment\", service=~\"$service\"}[5m])) by (le, service))",
            "legendFormat": "{{service}} P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{environment=\"$environment\", service=~\"$service\"}[5m])) by (le, service))",
            "legendFormat": "{{service}} P99",
            "refId": "B"
          }
        ],
        "title": "⚡ Response Time (P95/P99)",
        "type": "timeseries"
      },
      {
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 15
        },
        "id": 101,
        "title": "⚙️ INFRASTRUCTURE - USE METHODOLOGY",
        "type": "row",
        "collapsed": false
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "CPU utilization across services",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "never",
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "max": 100,
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 85}
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "id": 6,
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{environment=\"$environment\", service=~\"$service\"}[5m]) * 100",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "title": "🔄 CPU Usage (%)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Memory usage across services",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "never"
            },
            "unit": "bytes"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "id": 7,
        "targets": [
          {
            "expr": "process_resident_memory_bytes{environment=\"$environment\", service=~\"$service\"}",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "title": "💾 Memory Usage",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": ".NET Garbage Collection frequency and duration",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "showPoints": "never"
            },
            "unit": "ms"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 16
        },
        "id": 8,
        "targets": [
          {
            "expr": "rate(dotnet_gc_collection_seconds_total{environment=\"$environment\", service=~\"$service\"}[5m]) * 1000",
            "legendFormat": "{{service}} Gen{{generation}}",
            "refId": "A"
          }
        ],
        "title": "🗑️ .NET GC Duration",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Active thread/connection count",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "showPoints": "never"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 16
        },
        "id": 9,
        "targets": [
          {
            "expr": "process_threads{environment=\"$environment\", service=~\"$service\"}",
            "legendFormat": "{{service}} Threads",
            "refId": "A"
          }
        ],
        "title": "🧵 Active Threads",
        "type": "timeseries"
      },
      {
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "id": 102,
        "title": "🔗 DEPENDENCIES & EXTERNAL SERVICES",
        "type": "row",
        "collapsed": false
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "PostgreSQL active connections and connection pool status",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "showPoints": "never",
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "red", "value": 95}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 25
        },
        "id": 10,
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{environment=\"$environment\"}",
            "legendFormat": "{{datname}} Active Connections",
            "refId": "A"
          },
          {
            "expr": "pg_settings_max_connections{environment=\"$environment\"}",
            "legendFormat": "Max Connections",
            "refId": "B"
          }
        ],
        "title": "🗄️ PostgreSQL Connections",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Redis operations rate and cache hit ratio",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "showPoints": "never"
            },
            "unit": "ops"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 25
        },
        "id": 11,
        "targets": [
          {
            "expr": "rate(redis_commands_processed_total{environment=\"$environment\"}[5m])",
            "legendFormat": "Commands/sec",
            "refId": "A"
          },
          {
            "expr": "redis_keyspace_hits_total{environment=\"$environment\"} / (redis_keyspace_hits_total{environment=\"$environment\"} + redis_keyspace_misses_total{environment=\"$environment\"}) * 100",
            "legendFormat": "Cache Hit Rate %",
            "refId": "B"
          }
        ],
        "title": "📈 Redis Performance",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Message queue throughput and queue depth",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "showPoints": "never",
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1000},
                {"color": "red", "value": 5000}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 25
        },
        "id": 12,
        "targets": [
          {
            "expr": "rabbitmq_queue_messages_ready{environment=\"$environment\"}",
            "legendFormat": "{{queue}} Ready",
            "refId": "A"
          },
          {
            "expr": "rabbitmq_queue_messages_unacknowledged{environment=\"$environment\"}",
            "legendFormat": "{{queue}} Unacked",
            "refId": "B"
          }
        ],
        "title": "📤 Message Queue Status",
        "type": "timeseries"
      },
      {
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 33
        },
        "id": 103,
        "title": "💼 BUSINESS METRICS & KEY PERFORMANCE INDICATORS",
        "type": "row",
        "collapsed": false
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Key business metrics and user engagement",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "showPoints": "never"
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 34
        },
        "id": 13,
        "targets": [
          {
            "expr": "increase(vitrin_user_registrations_total{environment=\"$environment\"}[1h])",
            "legendFormat": "New Registrations/hour",
            "refId": "A"
          },
          {
            "expr": "increase(vitrin_votes_total{environment=\"$environment\"}[1h])",
            "legendFormat": "Votes/hour",
            "refId": "B"
          },
          {
            "expr": "increase(vitrin_comments_total{environment=\"$environment\"}[1h])",
            "legendFormat": "Comments/hour",
            "refId": "C"
          },
          {
            "expr": "increase(vitrin_product_submissions_total{environment=\"$environment\"}[1h])",
            "legendFormat": "New Products/hour",
            "refId": "D"
          }
        ],
        "title": "🎯 User Engagement Metrics",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus"
        },
        "description": "Revenue and conversion metrics",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 80}
              ]
            },
            "unit": "currencyUSD",
            "decimals": 2
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Conversion Rate"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                }
              ]
            }
          ]
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 34
        },
        "id": 14,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "sum(increase(vitrin_revenue_total{environment=\"$environment\"}[24h]))",
            "legendFormat": "Daily Revenue",
            "refId": "A"
          },
          {
            "expr": "(sum(increase(vitrin_purchases_total{environment=\"$environment\"}[24h])) / sum(increase(vitrin_visits_total{environment=\"$environment\"}[24h]))) * 100",
            "legendFormat": "Conversion Rate",
            "refId": "B"
          }
        ],
        "title": "💰 Revenue & Conversion",
        "type": "stat"
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "enable": true,
          "expr": "changes(vitrin_deployment_info{environment=\"$environment\"}[1m])",
          "iconColor": "#1f77b4",
          "name": "Deployments",
          "titleFormat": "Deployment: {{version}}",
          "textFormat": "New version deployed: {{version}}"
        }
      ]
    }
  }
}